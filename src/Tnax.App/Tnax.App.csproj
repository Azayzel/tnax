<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) Or '$(TnaxBuildIOS)' == 'true'">net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tnax.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>TNAX</ApplicationTitle>
    <ApplicationId>com.azayzel.tnax</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <MauiVersion>10.0.20</MauiVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../Tnax.Core/Tnax.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/Images/tnaxicon.svg" Color="#E3EDE6" />
    <MauiSplashScreen Include="Resources/Images/tnaxicon.svg" Color="#F5F7F5" BaseSize="96,96" />
    <MauiImage Include="Resources/Images/photo.svg;Resources/Images/video.svg" BaseSize="48,48" />
    <MauiAsset Include="Resources/LUCIDE-LICENSE" LogicalName="LUCIDE-LICENSE" />
  </ItemGroup>
</Project>
